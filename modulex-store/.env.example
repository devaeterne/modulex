# Public site
# Local development can use localhost. On Vercel, VERCEL_PROJECT_PRODUCTION_URL
# is used automatically when NEXT_PUBLIC_SITE_URL is not explicitly set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
# Use the same Supabase project as modulex-admin.
# Never expose a service-role/secret key through NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Contact form (temporary EmailJS transport)
# These are public client-side identifiers, not server secrets.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
