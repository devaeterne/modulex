NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only. Prefer the current Supabase secret key (sb_secret_...).
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional legacy fallback for older projects.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only transactional email provider key.
# Used for order, stock, pricing and invoice notifications.
RESEND_API_KEY=

# Local terminal smoke tests only. Never prefix these with NEXT_PUBLIC_.
# Use the Supabase direct or Session Pooler Postgres connection string.
SUPABASE_DB_URL=
# Active Modulex admin/super_admin credentials used by the read-only API/RLS smoke suite.
SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=
