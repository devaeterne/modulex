# Browser-safe runtime configuration. These values are bundled into the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical Modulex Admin origin for runtime links/redirects when needed.
# Keep this configuration-owned; do not hardcode a Vercel preview hostname or Store URL in source.
NEXT_PUBLIC_SITE_URL=
# Browser-safe Store origin only when client-side cross-app links need it.
# Server code should prefer STORE_SITE_URL below.
NEXT_PUBLIC_STORE_URL=

# Canonical Oakwell Store origin for server-generated portal activation links.
# Preferred for Admin server code; configure this per target environment.
STORE_SITE_URL=

# Server-only elevated Supabase access. Prefer the current sb_secret_... key.
# Never prefix privileged keys with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional server-only legacy fallback for older deployments.
# Prefer SUPABASE_SECRET_KEY for new configuration.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only transactional email provider key.
# Used for order, stock, pricing and invoice notifications.
RESEND_API_KEY=

# Server-only Google Calendar OAuth application credentials.
# Never expose these with NEXT_PUBLIC_ prefixes.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional when NEXT_PUBLIC_SITE_URL is canonical and stable.
GOOGLE_CALENDAR_REDIRECT_URI=
# Base64-encoded 32-byte AES key used only to encrypt Google refresh tokens at rest.
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Local terminal smoke tests only. Do not configure these as browser variables.
# Use the Supabase direct or Session Pooler Postgres connection string.
SUPABASE_DB_URL=
# Active Modulex admin/super_admin credentials used by the read-only API/RLS smoke suite.
SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=
